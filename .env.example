# Copy to .env (or export these) before running in anything but local dev.
# The app runs without them in dev, but values are ephemeral/insecure by default.

# JWT signing secret. REQUIRED in production. If unset, an ephemeral random
# secret is generated at startup (all tokens invalidate on restart).
SECRET=change-me-to-a-long-random-string

# Master key used to wrap stored AES content keys. REQUIRED in production.
# Without it, a known dev fallback key is used (no real confidentiality).
MASTER_KEY=change-me-to-a-long-random-string

# Comma-separated list of allowed browser origins for CORS.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional limits (defaults shown).
# MAX_UPLOAD_BYTES=26214400
# MAX_ZIP_UNCOMPRESSED_BYTES=52428800
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=300

# Optional: override the SQLite database location.
# DATABASE_PATH=server/docutrack.db
